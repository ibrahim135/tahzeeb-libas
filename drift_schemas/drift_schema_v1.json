  "fixed_sql": [
    {
      "name": "customers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"customers\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL CHECK(LENGTH(\"name\") > 0), \"normalized_name\" TEXT NOT NULL, \"mobile\" TEXT NULL, \"mobile_search\" TEXT NULL, \"alternate_mobile\" TEXT NULL, \"alternate_mobile_search\" TEXT NULL, \"address\" TEXT NULL, \"notes\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "orders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"orders\" (\"id\" TEXT NOT NULL, \"bill_number\" TEXT NOT NULL CHECK(LENGTH(\"bill_number\") > 0), \"bill_key\" TEXT NOT NULL UNIQUE, \"customer_id\" TEXT NOT NULL REFERENCES customers (id), \"order_date\" TEXT NOT NULL, \"delivery_date\" TEXT NOT NULL, \"status\" TEXT NOT NULL CHECK(\"status\" IN ('new', 'in_progress', 'ready', 'delivered', 'cancelled')), \"discount_paise\" INTEGER NOT NULL CHECK(\"discount_paise\" >= 0), \"notes\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK(delivery_date >= order_date));"
        }
      ]
    },
    {
      "name": "order_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"order_items\" (\"id\" TEXT NOT NULL, \"order_id\" TEXT NOT NULL REFERENCES orders (id), \"position\" INTEGER NOT NULL CHECK(\"position\" >= 0), \"garment_type\" TEXT NOT NULL CHECK(\"garment_type\" IN ('sherwani', 'suit', 'jothpuri', 'sadri', 'pant', 'shirt', 'kurta', 'payjama', 'thobe', 'joota', 'pagdi')), \"variant\" TEXT NULL, \"quantity\" INTEGER NOT NULL CHECK(\"quantity\" BETWEEN 1 AND 10000), \"unit_price_paise\" INTEGER NOT NULL CHECK(\"unit_price_paise\" BETWEEN 0 AND 100000000000), \"description\" TEXT NULL, \"measurement_config\" TEXT NOT NULL CHECK(\"measurement_config\" IN ('upper', 'lower', 'both', 'none')), \"measurement_unit\" TEXT NOT NULL DEFAULT 'inches' CHECK(\"measurement_unit\" = 'inches'), \"fitting_notes\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"order_id\", \"position\"));"
        }
      ]
    },
    {
      "name": "measurements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"measurements\" (\"item_id\" TEXT NOT NULL REFERENCES order_items (id), \"field_key\" TEXT NOT NULL, \"value_decimal\" TEXT NOT NULL, PRIMARY KEY (\"item_id\", \"field_key\"));"
        }
      ]
    },
    {
      "name": "payments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payments\" (\"id\" TEXT NOT NULL, \"order_id\" TEXT NOT NULL REFERENCES orders (id), \"amount_paise\" INTEGER NOT NULL CHECK(\"amount_paise\" BETWEEN 1 AND 100000000000), \"payment_date\" TEXT NOT NULL, \"method\" TEXT NULL, \"notes\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"voided_at\" TEXT NULL, \"void_reason\" TEXT NULL, \"replaces_payment_id\" TEXT NULL REFERENCES payments (id), PRIMARY KEY (\"id\"), CHECK((voided_at IS NULL AND void_reason IS NULL) OR (voided_at IS NOT NULL AND void_reason IS NOT NULL AND length(trim(void_reason)) > 0)));"
        }
      ]
    },
    {
      "name": "shop_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shop_settings\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"name\" TEXT NOT NULL, \"address\" TEXT NULL, \"contact\" TEXT NULL, \"receipt_notes\" TEXT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_state\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"next_bill_number\" INTEGER NOT NULL CHECK(\"next_bill_number\" > 0), PRIMARY KEY (\"id\"));"
        }
      ]
    },
